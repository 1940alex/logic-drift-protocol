{
  "harness_version": "paper-demo-0.1",
  "protocol_version": "LDP-v24",
  "api_provider": "openrouter",
  "api_key_env": "OPENROUTER_API_KEY",
  "openrouter_url": "https://openrouter.ai/api/v1/chat/completions",
  "runs_per_model": 1,
  "prompt_file": "prompts/logic_drift_protocol_v23_used_for_dataset.md",
  "models": [
    {
      "name": "claude-opus-4.5",
      "slug": "anthropic/claude-opus-4.5",
      "provider": "Anthropic"
    },
    {
      "name": "gemini-3-pro",
      "slug": "google/gemini-3-pro-preview",
      "provider": "Google"
    },
    {
      "name": "gpt-5.1",
      "slug": "openai/gpt-5.1",
      "provider": "OpenAI"
    },
    {
      "name": "o3",
      "slug": "openai/o3",
      "provider": "OpenAI"
    },
    {
      "name": "grok-4.1-fast",
      "slug": "x-ai/grok-4.1-fast",
      "provider": "xAI"
    }
  ],
  "request_settings": {
    "max_tokens": 4000,
    "timeout_seconds": 180,
    "rate_limit_delay_seconds": 2
  }
}
